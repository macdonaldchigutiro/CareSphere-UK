# Copy this file to docker/.env and replace every placeholder before deployment.
DB_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-django-secret

ALLOWED_HOSTS=caresphere.example.com
CORS_ALLOWED_ORIGINS=https://caresphere.example.com
CSRF_TRUSTED_ORIGINS=https://caresphere.example.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=wss://caresphere.example.com/ws

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

CQC_API_KEY=
NHS_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GRAFANA_PASSWORD=replace-with-a-long-random-password
